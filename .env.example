# Everything here is OPTIONAL. The demo runs fully with NO .env file:
# mock secrets, simulated Stripe, scripted agents, all four beats working.
# Copy to .env only to layer a real integration on top of the working free build.

# DEMO_MODE: scripted (default, zero external dependency) or live.
DEMO_MODE=scripted

# AGENT_LLM: scripted (default) | ollama | groq | gemini
AGENT_LLM=scripted

# 1Password real path. If set, the gateway resolves op:// refs for real.
# Needs the @1password/sdk package (npm i @1password/sdk). Without this token
# the gateway returns a mock value and the UI shows "secrets: mock".
OP_SERVICE_ACCOUNT_TOKEN=

# Stripe real TEST-mode path. If set (must start with sk_test_), the charge
# beat creates a real test PaymentIntent with a test card. Needs `npm i stripe`.
# Without it the charge is simulated and the UI shows "stripe: simulated".
STRIPE_TEST_SECRET_KEY=

# Optional free-tier hosted LLMs (only if AGENT_LLM=groq|gemini). Never required.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# GATEWAY_PORT=8787
# OLLAMA_MODEL=qwen2.5:3b
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-1.5-flash
